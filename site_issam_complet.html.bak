    <script>
        // Before/After Slider
        const baSlider = document.getElementById('baSlider');
        const baSliderHandle = document.getElementById('baSliderHandle');
        const baImgAfter = baSlider.querySelector('.ba-img-after');
        let isActive = false;

        function updateSlider(e) {
            if (!isActive && e.type !== 'touchstart') return;

            const rect = baSlider.getBoundingClientRect();
            let x = e.clientX - rect.left;

            if (e.touches) {
                x = e.touches[0].clientX - rect.left;
            }

            if (x < 0) x = 0;
            if (x > rect.width) x = rect.width;

            const percent = (x / rect.width) * 100;

            baSliderHandle.style.left = percent + '%';
            baImgAfter.style.width = percent + '%';
        }

        baSlider.addEventListener('mousedown', () => { isActive = true; });
        baSlider.addEventListener('touchstart', (e) => { isActive = true; updateSlider(e); });
        document.addEventListener('mouseup', () => { isActive = false; });
        document.addEventListener('touchend', () => { isActive = false; });
        document.addEventListener('mousemove', updateSlider);
        document.addEventListener('touchmove', updateSlider);

        // Initialize
        baImgAfter.style.width = '50%';
        baSliderHandle.style.left = '50%';
    </script>
</body>
