<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Issam Thoumas • Peinture Professionnelle</title>

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PD91XLRZBW"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-PD91XLRZBW', {
            'anonymize_ip': true,
            'cookie_expires': 63072000
        });
    </script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --navy: #1a3a52;
            --white: #ffffff;
            --light-gray: #f0ede7;
            --terracotta: #d4723a;
            --teal: #2a7f8e;
            --text-dark: #333333;
            --text-light: #666666;
            --orange: #E8932A;
            --orange-dark: #d17e1a;
            --border: #e0d9cf;
            --bg-warm: #f5f0e8;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
            line-height: 1.6;
            color: var(--text-dark);
            background: #d8cfc0;
        }

        /* ============ HEADER ============ */
        header {
            position: sticky;
            top: 0;
            background: #faf8f5;
            border-bottom: 1px solid rgba(212, 114, 58, 0.12);
            z-index: 1000;
        }

        .header-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--orange);
            letter-spacing: 2px;
            text-transform: uppercase;
            word-spacing: 8px;
            margin-left: -50px;
        }

        nav {
            display: flex;
            gap: 40px;
            align-items: center;
        }

        nav a {
            text-decoration: none;
            color: var(--text-dark);
            font-size: 0.95rem;
            font-weight: 500;
            transition: color 0.3s;
        }

        nav a:hover {
            color: var(--navy);
        }

        .btn-primary {
            background: var(--orange);
            color: var(--white);
            padding: 12px 28px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s;
            border: none;
            cursor: pointer;
        }

        .btn-primary:hover {
            background: var(--orange-dark);
            box-shadow: 0 8px 20px rgba(232, 147, 42, 0.3);
        }

        /* ============ HERO ============ */
        .hero {
            position: relative;
            height: 550px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--terracotta) 0%, var(--navy) 100%);
            overflow: hidden;
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.35);
        }

        .hero-content {
            position: relative;
            z-index: 10;
            text-align: center;
            color: var(--white);
            max-width: 900px;
            padding: 40px;
        }

        .hero-content h1 {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 20px;
            text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.4);
            line-height: 1.2;
        }

        .hero-content p {
            font-size: 1.3rem;
            margin-bottom: 40px;
            text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.3);
            font-weight: 300;
        }

        .hero-buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .hero-buttons .btn-primary {
            background: var(--white);
            color: var(--navy);
            font-weight: 700;
            padding: 16px 40px;
            font-size: 1rem;
        }

        .hero-buttons .btn-primary:hover {
            background: #f0ede7;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.2);
        }

        .hero-buttons a.btn-phone {
            background: var(--orange);
            color: var(--white);
            padding: 16px 40px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 700;
            font-size: 1rem;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .hero-buttons a.btn-phone:hover {
            background: var(--orange-dark);
        }

        /* ============ CONTAINER ============ */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 40px;
        }

        .section-title {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--navy);
            margin-bottom: 50px;
            text-align: center;
        }

        /* ============ TRUST SIGNALS ============ */
        .trust-signals {
            background: var(--bg-warm);
            padding: 80px 40px;
        }

        .trust-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
            margin-top: 50px;
        }

        .trust-card {
            background: var(--white);
            padding: 30px;
            border-radius: 12px;
            border-left: 4px solid var(--orange);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .trust-card h3 {
            font-size: 1.3rem;
            color: var(--navy);
            margin-bottom: 12px;
            font-weight: 700;
        }

        .trust-card p {
            color: var(--text-light);
            font-size: 0.95rem;
            line-height: 1.7;
        }

        .trust-avis {
            background: var(--white);
            padding: 30px;
            border-radius: 12px;
            border-left: 4px solid var(--teal);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            text-align: center;
        }

        .trust-avis-stars {
            font-size: 2rem;
            color: var(--orange);
            margin-bottom: 12px;
        }

        .trust-avis-text {
            font-weight: 700;
            color: var(--navy);
            font-size: 1.1rem;
            margin-bottom: 8px;
        }

        .trust-avis-count {
            color: var(--text-light);
            font-size: 0.95rem;
        }

        /* ============ WHY US ============ */
        .why-us {
            background: var(--white);
            padding: 80px 40px;
        }

        .why-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
            margin-top: 50px;
        }

        .why-card {
            background: var(--bg-warm);
            padding: 40px;
            border-radius: 8px;
            border-left: 4px solid var(--orange);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
            transition: transform 0.3s;
        }

        .why-card:hover {
            transform: translateY(-5px);
        }

        .why-card h3 {
            font-size: 1.3rem;
            color: var(--navy);
            margin-bottom: 15px;
            font-weight: 700;
        }

        .why-card p {
            color: var(--text-dark);
            font-size: 0.95rem;
            line-height: 1.8;
        }

        /* ============ SERVICES ============ */
        .services {
            background: var(--bg-warm);
            padding: 80px 40px;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-top: 50px;
        }

        .service-card {
            background: rgba(255, 255, 255, 0.95);
            padding: 40px;
            border-radius: 8px;
            border: 3px solid var(--orange);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        }

        .service-card h3 {
            font-size: 1.3rem;
            color: var(--navy);
            margin-bottom: 15px;
            font-weight: 700;
        }

        .service-card p {
            color: var(--text-dark);
            font-size: 0.95rem;
            line-height: 1.8;
        }

        /* ============ PORTFOLIO ============ */
        .portfolio {
            background: var(--white);
            padding: 80px 40px;
        }

        .portfolio-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
            margin-top: 50px;
        }

        .portfolio-card {
            background: var(--bg-warm);
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
            transition: transform 0.3s;
        }

        .portfolio-card:hover {
            transform: translateY(-5px);
        }

        .portfolio-image {
            width: 100%;
            height: 280px;
            background: linear-gradient(135deg, var(--terracotta) 0%, var(--teal) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--white);
            font-size: 0.9rem;
        }

        .portfolio-info {
            padding: 30px;
        }

        .portfolio-label {
            display: inline-block;
            background: var(--orange);
            color: var(--white);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            margin-bottom: 12px;
        }

        .portfolio-info h4 {
            font-size: 1.2rem;
            color: var(--navy);
            margin-bottom: 10px;
            font-weight: 700;
        }

        .portfolio-info p {
            color: var(--text-light);
            font-size: 0.9rem;
            line-height: 1.6;
        }

        /* ============ BEFORE/AFTER SLIDER ============ */
        .ba-container {
            position: relative;
            width: 100%;
            overflow: hidden;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .ba-img-before,
        .ba-img-after {
            width: 100%;
            height: 280px;
            object-fit: cover;
            display: block;
        }

        .ba-img-after {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        .ba-img-after img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .ba-slider {
            position: absolute;
            top: 0;
            left: 50%;
            width: 4px;
            height: 100%;
            background: var(--orange);
            cursor: col-resize;
            transform: translateX(-50%);
        }

        .ba-label {
            position: absolute;
            top: 10px;
            padding: 6px 12px;
            background: rgba(0, 0, 0, 0.6);
            color: var(--white);
            font-size: 0.75rem;
            font-weight: 700;
            border-radius: 4px;
            text-transform: uppercase;
        }

        .ba-label-before {
            left: 10px;
        }

        .ba-label-after {
            right: 10px;
        }

        /* ============ ABOUT / PRÉSENTATION ============ */
        .about {
            background: var(--white);
            padding: 100px 40px;
        }

        .about-grid {
            max-width: 900px;
            margin: 0 auto;
        }

        .about-text {
            text-align: center;
        }

        .about-text h2 {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--navy);
            margin: 0 0 40px 0;
            letter-spacing: -0.3px;
            text-align: center;
        }

        .about-text p {
            color: #2b2b2b;
            font-size: 1.1rem;
            line-height: 1.9;
            margin-bottom: 25px;
            font-weight: 400;
        }

        .about-list {
            margin-top: 35px;
            list-style: none;
            display: inline-block;
            text-align: left;
        }

        .about-list li {
            font-size: 1.05rem;
            color: var(--text-dark);
            padding: 12px 0;
            padding-left: 35px;
            position: relative;
            font-weight: 600;
            line-height: 1.7;
            border-bottom: 1px solid rgba(232, 147, 42, 0.15);
        }

        .about-list li:last-child {
            border-bottom: none;
        }

        .about-list li:before {
            content: "✓";
            position: absolute;
            left: 0;
            color: var(--orange);
            font-weight: 800;
            font-size: 1.2rem;
        }

        /* ============ CONTACT ============ */
        .contact {
            background: var(--bg-warm);
            padding: 80px 40px;
        }

        .contact-content {
            max-width: 800px;
            margin: 0 auto;
        }

        .contact-content h2 {
            font-size: 2.2rem;
            color: var(--navy);
            margin-bottom: 50px;
            text-align: center;
            font-weight: 800;
        }

        form {
            background: var(--white);
            padding: 50px;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
            margin-bottom: 50px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-label {
            display: block;
            font-weight: 600;
            color: var(--navy);
            margin-bottom: 10px;
            font-size: 0.95rem;
        }

        .form-input,
        .form-select,
        .form-textarea {
            width: 100%;
            padding: 14px;
            border: 2px solid #e0d9cf;
            border-radius: 6px;
            font-family: inherit;
            font-size: 0.95rem;
            transition: border-color 0.3s;
        }

        .form-input:focus,
        .form-select:focus,
        .form-textarea:focus {
            outline: none;
            border-color: var(--orange);
            box-shadow: 0 0 0 3px rgba(232, 147, 42, 0.1);
        }

        .form-textarea {
            resize: vertical;
            min-height: 120px;
        }

        .form-submit {
            width: 100%;
            padding: 16px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
        }

        .contact-info {
            background: var(--white);
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

        .contact-info h3 {
            font-size: 1.4rem;
            color: var(--navy);
            margin-bottom: 25px;
            font-weight: 700;
        }

        .contact-info p {
            font-size: 1.1rem;
            color: var(--text-dark);
            margin-bottom: 15px;
            font-weight: 600;
        }

        .contact-info a {
            color: var(--orange);
            text-decoration: none;
            font-weight: 700;
        }

        .contact-info a:hover {
            text-decoration: underline;
        }

        /* ============ FOOTER ============ */
        footer {
            background: var(--navy);
            color: var(--white);
            padding: 60px 40px;
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            text-align: center;
        }

        .footer-content h3 {
            font-size: 1.5rem;
            margin-bottom: 20px;
            font-weight: 800;
        }

        .footer-content p {
            margin-bottom: 15px;
            line-height: 1.8;
        }

        footer a {
            color: var(--orange);
            text-decoration: none;
            font-weight: 600;
        }

        footer a:hover {
            text-decoration: underline;
        }

        /* ============ RESPONSIVE ============ */
        @media (max-width: 768px) {
            .header-content {
                flex-direction: column;
                gap: 15px;
                padding: 15px 20px;
            }

            nav {
                flex-direction: column;
                gap: 15px;
                width: 100%;
            }

            .logo {
                margin-left: 0;
                font-size: 1.4rem;
            }

            .hero-content h1 {
                font-size: 2.2rem;
            }

            .hero-content p {
                font-size: 1rem;
            }

            .hero-buttons {
                flex-direction: column;
                gap: 15px;
            }

            .hero-buttons .btn-primary,
            .hero-buttons a.btn-phone {
                width: 100%;
                text-align: center;
            }

            .section-title {
                font-size: 1.8rem;
            }

            .container {
                padding: 0 20px;
            }

            .about-text h2 {
                font-size: 1.5rem;
            }

            .about-text p {
                font-size: 1rem;
            }

            .about-list li {
                font-size: 0.95rem;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            form {
                padding: 30px 20px;
            }

            .contact {
                padding: 50px 20px;
            }

            .hero {
                height: 400px;
            }
        }
    </style>
</head>
<body>
    <!-- HEADER -->
    <header>
        <div class="header-content">
            <div class="logo">Peinture Toulouse</div>
            <nav>
                <a href="#services">Services</a>
                <a href="#portfolio">Portfolio</a>
                <a href="#about">Présentation</a>
                <a href="#contact">Contact</a>
            </nav>
        </div>
    </header>

    <!-- HERO -->
    <section class="hero">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <h1>Votre Espace, Votre Vision</h1>
            <p>Qualité, Créativité, Précision</p>
            <div class="hero-buttons">
                <a href="#contact" class="btn-primary">Demander un devis</a>
                <a href="tel:0652845785" class="btn-phone">📞 06 52 84 57 85</a>
            </div>
        </div>
    </section>

    <!-- TRUST SIGNALS -->
    <section class="trust-signals">
        <div class="container">
            <div class="trust-grid">
                <div class="trust-card">
                    <h3>✓ Garantie Décennale</h3>
                    <p>Couverture complète de tous les travaux avec assurance décennale.</p>
                </div>
                <div class="trust-card">
                    <h3>⚡ Intervention < 48h</h3>
                    <p>Réactivité maximale pour vos demandes urgentes et projets pressants.</p>
                </div>
                <div class="trust-card">
                    <h3>👨‍💼 6+ ans d'expérience</h3>
                    <p>Expertise confirmée en peinture intérieure, décoration et revêtements.</p>
                </div>
                <div class="trust-avis">
                    <div class="trust-avis-stars">★★★★★</div>
                    <div class="trust-avis-text">4.8 / 5</div>
                    <div class="trust-avis-count">12+ clients satisfaits</div>
                </div>
            </div>
        </div>
    </section>

    <!-- WHY US -->
    <section class="why-us">
        <div class="container">
            <h2 class="section-title">Pourquoi Nous Faire Confiance</h2>
            <div class="why-grid">
                <div class="why-card">
                    <h3>Audit Qualité Sérieux</h3>
                    <p>Avant chaque devis, un audit approfondi de votre projet pour un travail impeccable.</p>
                </div>
                <div class="why-card">
                    <h3>Expertise Plurielle</h3>
                    <p>Peinture intérieure, décoration créative, revêtements sol — tous vos besoins couverts.</p>
                </div>
                <div class="why-card">
                    <h3>Communication Transparente</h3>
                    <p>Devis précis, délais respectés, suivi constant du chantier jusqu'à la finition.</p>
                </div>
                <div class="why-card">
                    <h3>Garantie Satisfaction</h3>
                    <p>RC professionnelle + assurance décennale = votre tranquillité d'esprit garantie.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- SERVICES -->
    <section class="services" id="services">
        <div class="container">
            <h2 class="section-title">Nos Services</h2>
            <div class="services-grid">
                <div class="service-card">
                    <h3>Peinture Intérieure</h3>
                    <p>Transformation complète de vos espaces intérieurs avec finitions premium et durables.</p>
                </div>
                <div class="service-card">
                    <h3>Décoration & Créativité</h3>
                    <p>Conseils en couleur, décoration murale, effets spéciaux — réalisez vos rêves.</p>
                </div>
                <div class="service-card">
                    <h3>Revêtements Sol</h3>
                    <p>Revêtements sol professionnels pour une durabilité et une esthétique garanties.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- PORTFOLIO -->
    <section class="portfolio" id="portfolio">
        <div class="container">
            <h2 class="section-title">Nos Réalisations</h2>
            <div class="portfolio-grid">
                <div class="portfolio-card">
                    <div class="ba-container" id="baSlider">
                        <img src="data:image/jpeg;base64," alt="Couloir Avant" class="ba-img-before">
                        <div class="ba-img-after">
                            <img src="data:image/jpeg;base64," alt="Couloir Après">
                        </div>
                        <div class="ba-slider" id="baSliderHandle"></div>
                        <div class="ba-label ba-label-before">AVANT</div>
                        <div class="ba-label ba-label-after">APRÈS</div>
                    </div>
                    <div class="portfolio-info">
                        <span class="portfolio-label">Peinture</span>
                        <h4>Couloir Entrée</h4>
                        <p>Transformation complète d'une entrée. De brut à lumineux et professionnel.</p>
                    </div>
                </div>
                <div class="portfolio-card">
                    <div class="ba-container" id="baSlider">
                        <img src="data:image/jpeg;base64," alt="Couloir Avant" class="ba-img-before">
                        <div class="ba-img-after">
                            <img src="data:image/jpeg;base64," alt="Couloir Après">
                        </div>
                        <div class="ba-slider" id="baSliderHandle"></div>
                        <div class="ba-label ba-label-before">AVANT</div>
                        <div class="ba-label ba-label-after">APRÈS</div>
                    </div>
                    <div class="portfolio-info">
                        <span class="portfolio-label">Peinture</span>
                        <h4>Couloir Entrée</h4>
                        <p>Transformation complète d'une entrée brute en espace lumineux et professionnel.</p>
                    </div>
                </div>
                <div class="portfolio-card">
                    <div class="portfolio-image">Photo à venir</div>
                    <div class="portfolio-info">
                        <span class="portfolio-label">Peinture</span>
                        <h4>Cuisine Professionnelle</h4>
                        <p>Finition brillante et durabilité garantie sur tous les travaux.</p>
                    </div>
                </div>
                <div class="portfolio-card">
                    <div class="portfolio-image">Photo à venir</div>
                    <div class="portfolio-info">
                        <span class="portfolio-label">Décoration</span>
                        <h4>Salon Cosy</h4>
                        <p>Finition brillante et durabilité garantie sur tous les travaux.</p>
                    </div>
                </div>
                <div class="portfolio-card">
                    <div class="portfolio-image">Photo à venir</div>
                    <div class="portfolio-info">
                        <span class="portfolio-label">Créatif</span>
                        <h4>Chambre Créative</h4>
                        <p>Finition brillante et durabilité garantie sur tous les travaux.</p>
                    </div>
                </div>
                <div class="portfolio-card">
                    <div class="portfolio-image">Photo à venir</div>
